[Unit]
Description=Window Sync Raspberry Pi daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/window_sync_supabase_project/pi
ExecStart=/home/pi/window_sync_supabase_project/pi/.venv/bin/python   /home/pi/window_sync_supabase_project/pi/daemon.py   --config /home/pi/window_sync_supabase_project/pi/config.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
